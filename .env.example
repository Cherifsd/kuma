# Copiez ce fichier en ".env" et remplissez-le.

# Clé de l'API Claude (pour le compte rendu) : https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Modèle de transcription (voir README pour choisir selon votre machine)
KUMA_ASR_MODEL=omniASR_LLM_Unlimited_300M_v2

# auto = vraie transcription si installée, sinon mode démo. Valeurs : auto, demo, omnilingual
KUMA_ASR_ENGINE=auto

# Modèle Claude utilisé pour le résumé
KUMA_CLAUDE_MODEL=claude-sonnet-5-5
